+"""Synthetic-only checks for the NX latest-received input policy."""
+import os
+import time
+from types import SimpleNamespace
+
+import pytest
+
+pytestmark = pytest.mark.skipif(os.environ.get('SCIENCE_ROS_TEST') != '1',
+                                reason='requires isolated DDS domain')
+
+
+def test_latest_odom_accepts_old_future_and_repeated_source_stamps():
+    import rclpy
+    from geometry_msgs.msg import TransformStamped
+    from nav_msgs.msg import Odometry
+    from go2_science_perception.science_target_approach import ScienceTargetApproach
+    from go2_science_perception.latest_data import LATEST_DATA
+
+    assert LATEST_DATA and os.environ['ROS_DOMAIN_ID'] == '86'
+    rclpy.init(args=['--ros-args', '-p', 'grasp_docking_enabled:=true'])
+    node = ScienceTargetApproach()
+    try:
+        now = node.get_clock().now().nanoseconds
+        # TF exists only at current time, unrelated to any message source stamp.
+        for child in ('vehicle', 'camera_link'):
+            transform = TransformStamped()
+            transform.header.frame_id = 'map'
+            transform.header.stamp = node.get_clock().now().to_msg()
+            transform.child_frame_id = child
+            transform.transform.rotation.w = 1.0
+            node.tf_buffer.set_transform(transform, 'latest_test')
+        for stamp in (now-20_000_000_000, now-20_000_000_000, now+60_000_000_000, 0):
+            message = Odometry()
+            message.header.frame_id = 'map'
+            message.header.stamp = rclpy.time.Time(nanoseconds=stamp).to_msg()
+            message.pose.pose.orientation.w = 1.0
+            previous = node.matched_odom_count
+            node._odom(message)
+            assert node.matched_odom_count == previous + 1
+            assert node.verified_vehicle_pose is not None
+            assert node.verified_vehicle_pose['stamp_ns'] >= now
+            assert message.header.stamp.sec*10**9+message.header.stamp.nanosec == stamp
+            assert node.core.state != 'FAULT'
+            time.sleep(.01)
+        node.armed_once = True
+        node.core.odom_time = time.monotonic()-1.1
+        node._tick()
+        assert node.core.state == 'FAULT'
+        assert 'input reception stopped' in node.core.reason
+    finally:
+        node.stop()
+        node.destroy_node()
+        rclpy.shutdown()
+
+
+def test_latest_mission_odom_accepts_old_stamp_and_latest_tf():
+    import rclpy
+    from nav_msgs.msg import Odometry
+    from go2_science_perception.mission_manager import MissionManager
+    from collections import deque
+    mission = MissionManager.__new__(MissionManager)
+    mission.node = SimpleNamespace(get_clock=lambda: SimpleNamespace(
+        now=lambda: rclpy.time.Time(nanoseconds=50_000_000_000)))
+    mission.now_ns = lambda: 50_000_000_000
+    mission.pending_odom = deque(maxlen=32)
+    mission.last_odom_ns = 0
+    mission.pose = None
+    message = Odometry()
+    message.header.frame_id = 'map'
+    message.header.stamp.sec = 1
+    message.pose.pose.orientation.w = 1.
+    # Exercise the same receipt policy used by the subscription wrapper.
+    from go2_science_perception.latest_data import receipt_copy
+    mission.odom(receipt_copy(message, mission.node.get_clock().now()))
+    assert mission.pending_odom[-1][0] == 50_000_000_000
+    requested = []
+    def lookup(_target, _source, when):
+        requested.append(when.nanoseconds)
+        return SimpleNamespace(transform=SimpleNamespace(
+            translation=SimpleNamespace(x=.01,y=.0,z=.0),
+            rotation=SimpleNamespace(x=.0,y=.0,z=.0,w=1.)))
+    mission.tf = SimpleNamespace(lookup_transform=lookup)
+    assert mission.match_body_pose() is None
+    assert requested == [0]
+    assert mission.pose[0] == .01
+
+
+def test_latest_depth_context_uses_last_received_depth_without_stamp_alignment():
+    import numpy as np
+    from collections import deque
+    from sensor_msgs.msg import Image, CameraInfo
+    from go2_science_perception.yolo_detector import YoloDetector
+    rgb = Image()
+    rgb.header.frame_id = 'optical'
+    rgb.header.stamp.sec = 100
+    near = Image()
+    near.header.frame_id = 'optical'
+    near.header.stamp.sec = 100
+    last = Image()
+    last.header.frame_id = 'optical'
+    last.header.stamp.sec = 1
+    last.width = last.height = 2
+    last.encoding = '16UC1'
+    info = CameraInfo()
+    info.header.frame_id = 'optical'
+    info.header.stamp.sec = 600
+    info.width = info.height = 2
+    node = SimpleNamespace(depths=deque([near, last]), info=info, depth_received_at=time.monotonic(),
+                           cfg={}, bridge=SimpleNamespace(
+                               imgmsg_to_cv2=lambda msg, encoding: np.ones((2, 2))*1000))
+    result, chosen, reason = YoloDetector._depth_context(node, rgb, (2,2))
+    assert chosen is last and reason == ''
+    np.testing.assert_allclose(result, 1.)
+    node.depth_received_at = time.monotonic()-2
+    assert YoloDetector._depth_context(node, rgb, (2,2))[2] == 'depth_input_reception_stopped'
+
+
+def test_target_adapter_accepts_latest_report_without_source_age_comparison():
+    import json
+    import rclpy.time
+    from go2_science_perception.color_block_target_adapter import ColorBlockTargetAdapter
+    node = SimpleNamespace(last_published=100_000_000_000, latest=None,
+                           get_clock=lambda: SimpleNamespace(
+                               now=lambda: rclpy.time.Time(nanoseconds=101_000_000_000)))
+    for ns in (0,1,999_000_000_000):
+        ColorBlockTargetAdapter._frame(node, SimpleNamespace(data=json.dumps({'rgb_stamp_ns':ns})))
+        assert node.latest['rgb_stamp_ns'] == 101_000_000_000
+        assert node.latest['source_rgb_stamp_ns'] == ns
