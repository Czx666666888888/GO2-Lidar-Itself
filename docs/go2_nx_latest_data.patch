+"""NX application input policy. Source timestamps remain diagnostic metadata."""
+import copy
+import os
+
+LATEST_DATA = os.environ.get("GO2_LATEST_DATA") == "1"
+RECEIPT_TIMEOUT = 1.0
+
+
+def receipt_copy(message, now):
+    """Use the local receipt stamp without copying large image/cloud payloads."""
+    if not LATEST_DATA:
+        return message
+    result = copy.copy(message)
+    result.header = copy.copy(message.header)
+    result.header.stamp = now.to_msg()
+    return result
+
+
+def query_time(stamp):
+    import rclpy.time
+    return rclpy.time.Time() if LATEST_DATA else rclpy.time.Time.from_msg(stamp)
