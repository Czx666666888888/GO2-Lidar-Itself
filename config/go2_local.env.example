# Copy to go2_local.env on the deployment host; these are host-local workspaces.
GO2_ROS_SETUP=/opt/ros/foxy/setup.bash
GO2_DDS_SETUP="$HOME/cyclonedds_ws/install/setup.bash"
GO2_CAMERA_SETUP="$HOME/go2_d435_foxy_ws/install/setup.bash"
GO2_TIME_UNDERLAY="$HOME/go2_autonomy_ws/install/setup.bash"
# Optional explicit DDS interface; no PC peer is required.
GO2_TIME_INTERFACE=eth0
GO2_TIME_MAPPING_MODE=legacy
