Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /registered_scan
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
    - Class: rviz_default_plugins/PointCloud2
      Name: Terrain
      Enabled: true
      Topic:
        Value: /terrain_map
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 4
      Color Transformer: Intensity
    - Class: rviz_default_plugins/Path
      Name: Local Path
      Enabled: true
      Color: 25; 255; 100
      Topic:
        Value: /path
    - Class: rviz_default_plugins/Odometry
      Name: GO2 Center
      Enabled: true
      Keep: 1
      Topic:
        Value: /base_state_estimation
        Reliability Policy: Best Effort
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
