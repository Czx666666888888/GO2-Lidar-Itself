<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_keyboard_teleop</name>
  <version>0.1.0</version>
  <description>Keyboard teleoperation for Unitree Go2: publish Twist velocity commands only, no path planning involved.</description>
  <maintainer email="dev@example.com">go2-dev</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>unitree_api</depend>

  <exec_depend>go2_robot_sdk</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
